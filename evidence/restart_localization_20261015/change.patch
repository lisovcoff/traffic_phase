+"""Declared independent world trajectories, NOT generated by the localizer."""
+import copy
+
+import numpy as np
+
+
+def generate_case(spec, config):
+    kind=spec['kind']
+    dt=config['dt_coarse_s'] if kind=='abrupt_dt02' else config['dt_s']
+    onset=config['sine_witness_onset_s'] if kind=='sine_witness' else config['onset_s']
+    t=np.arange(config['extent_s'][0],config['extent_s'][1]+dt/2,dt)
+    delta=np.maximum(0,t-onset)
+    position=.3+config['movement_rate_coordinate_per_s']*delta
+    if kind=='acceleration':
+        position=.3+.5*config['acceleration_coordinate_per_s2']*delta**2
+    if kind in ['no_motion','isolated_spike']:
+        position=np.full_like(t,.3)
+    if kind=='nonstop':
+        position=.3+config['movement_rate_coordinate_per_s']*t
+    if kind=='isolated_spike':
+        position[np.argmin(abs(t-config['spike_at_s']))]+=config['spike_amplitude']
+    noise=np.random.default_rng(spec['seed']).uniform(-1,1,len(t))*config['coordinate_noise_uniform_halfwidth']
+    if kind=='sine_witness':
+        noise=config['coordinate_noise_uniform_halfwidth']*np.sin(3*t)
+    origin,target='N','_S'
+    detections=[dict(millis=int(round(time*1000)),centroid_x=float(x+j),centroid_y=.5,
+        speed=.1,zone=origin if time<30 else target) for time,x,j in zip(t,position,noise)]
+    if kind=='observation_gap':
+        lo,hi=config['observation_gap_open_s']
+        detections=[d for d in detections if not lo*1000<d['millis']<hi*1000]
+    if kind=='truncated_after_onset':
+        detections=[d for d in detections if d['millis']<=config['truncated_end_s']*1000]
+    if kind=='identical_duplicates':
+        detections=[copy.deepcopy(d) for row in detections for d in [row,row]]
+    if kind=='conflicting_duplicates':
+        row=copy.deepcopy(next(d for d in detections if d['millis']==20100))
+        row['centroid_x']+=.02
+        detections.append(row)
+    if kind=='empty':
+        detections=[]
+    track=dict(id=1,zone_in=origin,zone_out=target,stay_duration_millis=0,detections=detections)
+    return track,dict(independent_world_onset_ms=onset*1000,dt_ms=dt*1000,kind=kind)
