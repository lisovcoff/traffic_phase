+def test_bijective_movement_rename_preserves_result():
+    r, e = inputs()
+    a = compare_review(r, e, [1])[0]
+    e[0]['movement'] = 'renamed'
+    b = compare_review(r, e, [1])[0]
+    assert {k:v for k,v in a.items() if k != 'movement'} == {
+        k:v for k,v in b.items() if k != 'movement'}
