+            if not row['inventory_complete']:
+                row['reason'] = ('SOURCE_TIMEOUT_BEFORE_SESSION_INVENTORY' if process['status'] == 'TIMEOUT' else
+                                 row.get('source_error', {}).get('reason', 'SESSION_INVENTORY_UNAVAILABLE'))
